{
  "TimeZone": {
    "Id": "Asia/Kolkata",
    "DisplayName": "India Standard Time"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "Comment": "Production uses PostgreSQL (Neon - Frankfurt)"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=${POSTGRES_HOST};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};SSL Mode=Require;Trust Server Certificate=true",
    "Comment": "Set via environment variables or creds.local.md"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "PixelCCMS",
    "Audience": "PixelCCMSUsers",
    "ExpiryMinutes": 60,
    "Comment": "Set via environment variable: JWT_SECRET_KEY (minimum 32 characters)"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com"
    ],
    "Comment": "Replace with your actual production domains"
  },
  "FileStorage": {
    "Provider": "R2",
    "MaxFileSizeInMB": 100,
    "Comment": "Using Cloudflare R2 for production (zero egress fees)"
  },
  "R2": {
    "AccountId": "${R2_ACCOUNT_ID}",
    "AccessKeyId": "${R2_ACCESS_KEY_ID}",
    "SecretAccessKey": "${R2_SECRET_ACCESS_KEY}",
    "BucketName": "prod-ccms",
    "PublicUrlBase": "${R2_PUBLIC_URL_BASE}",
    "Comment": "Set via environment variables or creds.local.md"
  },
  "BookingStatusUpdate": {
    "BackgroundService": {
      "Enabled": true,
      "IntervalMinutes": 1
    }
  },
  "StreamingSettings": {
    "StreamTimeoutMinutes": 5,
    "ExpiryCheckIntervalMinutes": 2,
    "DefaultMaxViewers": 5
  },
  "WebRTC": {
    "StunServers": [
      "stun:stun.l.google.com:19302",
      "stun:stun1.l.google.com:19302"
    ],
    "TurnServers": [
      {
        "Urls": "${TURN_SERVER_URL}",
        "Username": "${TURN_USERNAME}",
        "Credential": "${TURN_PASSWORD}",
        "Comment": "Configure TURN server for NAT traversal"
      }
    ],
    "MaxViewersPerStream": 10,
    "StreamTimeoutSeconds": 300
  },
  "AWS": {
    "SES": {
      "AccessKeyId": "${AWS_SES_ACCESS_KEY_ID}",
      "SecretAccessKey": "${AWS_SES_SECRET_ACCESS_KEY}",
      "Region": "ap-south-1",
      "FromEmail": "noreply@yourdomain.com"
    }
  },
  "ComBirds": {
    "ApiKey": "${COMBIRDS_API_KEY}",
    "SenderId": "${COMBIRDS_SENDER_ID}",
    "TemplateId": "${COMBIRDS_TEMPLATE_ID}",
    "BaseUrl": "https://smsapi.edumarcsms.com/api/v1",
    "DevelopmentMode": false
  },
  "App": {
    "BaseUrl": "https://yourdomain.com"
  }
}
