{
  "TimeZone": {
    "Id": "Asia/Kolkata",
    "DisplayName": "India Standard Time"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Error"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "PostgreSQL",
    "Comment": "Production uses PostgreSQL"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=${POSTGRES_HOST};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD};SSL Mode=Require;Trust Server Certificate=true",
    "Comment": "Set via environment variables in production"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "PixelCCMS",
    "Audience": "PixelCCMSUsers",
    "ExpiryMinutes": 60,
    "Comment": "JWT_SECRET_KEY must be minimum 32 characters"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://pixelspot.in",
      "https://www.pixelspot.in",
      "https://app.pixelspot.in"
    ],
    "Comment": "Production domains only"
  },
  "FileStorage": {
    "Provider": "R2",
    "MaxFileSizeInMB": 2048,
    "MaxDurationSeconds": 160,
    "Comment": "Cloudflare R2 for production - Max 2GB, 160 seconds"
  },
  "R2": {
    "AccountId": "${R2_ACCOUNT_ID}",
    "AccessKeyId": "${R2_ACCESS_KEY_ID}",
    "SecretAccessKey": "${R2_SECRET_ACCESS_KEY}",
    "BucketName": "prod-ccms",
    "PublicUrlBase": "${R2_PUBLIC_URL_BASE}",
    "Comment": "Set via environment variables"
  },
  "BookingStatusUpdate": {
    "BackgroundService": {
      "Enabled": true,
      "IntervalMinutes": 1
    }
  },
  "PlaybackSettings": {
    "FlushIntervalMinutes": 5,
    "MaxBufferSize": 50000,
    "Comment": "Production playback logging - flush every 5 minutes"
  },
  "StreamingSettings": {
    "StreamTimeoutMinutes": 10,
    "ExpiryCheckIntervalMinutes": 5,
    "DefaultMaxViewers": 50,
    "Comment": "Production streaming settings"
  },
  "WebRTC": {
    "StunServers": [
      "stun:stun.l.google.com:19302",
      "stun:stun1.l.google.com:19302"
    ],
    "TurnServers": [
      {
        "Urls": "${TURN_SERVER_URL}",
        "Username": "${TURN_USERNAME}",
        "Credential": "${TURN_PASSWORD}"
      }
    ],
    "MaxViewersPerStream": 50,
    "StreamTimeoutSeconds": 600,
    "Comment": "TURN server required for production NAT traversal"
  },
  "AWS": {
    "SES": {
      "AccessKeyId": "${AWS_SES_ACCESS_KEY_ID}",
      "SecretAccessKey": "${AWS_SES_SECRET_ACCESS_KEY}",
      "Region": "ap-south-1",
      "FromEmail": "noreply@pixelspot.in"
    }
  },
  "Email": {
    "DevelopmentMode": false,
    "Comment": "Production sends real emails"
  },
  "ComBirds": {
    "ApiKey": "${COMBIRDS_API_KEY}",
    "SenderId": "${COMBIRDS_SENDER_ID}",
    "TemplateId": "${COMBIRDS_TEMPLATE_ID}",
    "BaseUrl": "https://smsapi.edumarcsms.com/api/v1",
    "DevelopmentMode": false,
    "Comment": "Production sends real SMS"
  },
  "App": {
    "BaseUrl": "https://app.pixelspot.in",
    "Comment": "Production frontend URL"
  },
  "DefaultVideo": {
    "UniversalFallbackUrl": "${R2_PUBLIC_URL_BASE}/Pixel_Universal.mp4",
    "Comment": "Universal fallback video from production R2"
  }
}
