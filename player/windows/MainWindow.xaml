<Window x:Class="PixelSpot.Player.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelSpot Player"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black">

  <Grid>
    <!-- Primary video player -->
    <MediaElement x:Name="VideoPlayer"
                  Stretch="Fill"
                  LoadedBehavior="Manual"
                  UnloadedBehavior="Stop"
                  MediaEnded="OnMediaEnded"
                  MediaFailed="OnMediaFailed"/>

    <!-- Overlay for images -->
    <Image x:Name="ImageDisplay" Stretch="Fill" Visibility="Collapsed"/>

    <!-- Status overlay (bottom-right, shown briefly on events) -->
    <Border x:Name="StatusOverlay" Background="#80000000"
            HorizontalAlignment="Right" VerticalAlignment="Bottom"
            Padding="12,6" Margin="0,0,16,16" CornerRadius="4"
            Visibility="Collapsed">
      <TextBlock x:Name="StatusText" Foreground="White" FontSize="13"/>
    </Border>

    <!-- Sync / loading indicator -->
    <StackPanel x:Name="SyncOverlay" HorizontalAlignment="Center"
                VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="PixelSpot Player" Foreground="#6366f1"
                 FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="SyncLabel" Text="Syncing content..."
                 Foreground="White" FontSize="14" HorizontalAlignment="Center"
                 Margin="0,8,0,0"/>
    </StackPanel>
  </Grid>
</Window>
