<Window x:Class="PixelSpot.Player.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelSpot Player — Device Pairing"
        Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a"
        ResizeMode="NoResize">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#f8fafc"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="40" VerticalAlignment="Center">

    <!-- Logo / Title -->
    <TextBlock Text="PixelSpot Player" FontSize="24" FontWeight="Bold"
               Foreground="#6366f1" HorizontalAlignment="Center" Margin="0,0,0,8"/>
    <TextBlock Text="Pair this device with your PixelSpot screen"
               FontSize="14" Foreground="#94a3b8" HorizontalAlignment="Center"
               Margin="0,0,0,32"/>

    <!-- QR Code placeholder (rendered at runtime) -->
    <Border x:Name="QrBorder" Width="200" Height="200" Background="White"
            HorizontalAlignment="Center" Margin="0,0,0,16">
      <Image x:Name="QrImage" Stretch="Fill"/>
    </Border>

    <!-- Pairing code display -->
    <TextBlock x:Name="PairingCodeLabel" Text="Generating code..."
               FontSize="28" FontWeight="Bold" Foreground="#6366f1"
               HorizontalAlignment="Center" Margin="0,0,0,8"
               FontFamily="Courier New"/>
    <TextBlock Text="Enter this 6-character code in the PixelSpot dashboard"
               FontSize="12" Foreground="#94a3b8" HorizontalAlignment="Center"
               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24"/>

    <!-- Status message -->
    <TextBlock x:Name="StatusLabel" Text="Waiting for admin approval..."
               FontSize="13" Foreground="#94a3b8" HorizontalAlignment="Center"
               Margin="0,0,0,24"/>

    <!-- Manual code entry -->
    <TextBlock Text="Or enter code manually:" FontSize="12" Foreground="#94a3b8"
               HorizontalAlignment="Center" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <TextBox x:Name="ManualCodeBox" Width="140" FontSize="16" Padding="8,6"
               MaxLength="6" Background="#1e293b" Foreground="#f8fafc"
               BorderBrush="#6366f1" CaretBrush="White" Margin="0,0,8,0"/>
      <Button Content="Pair" Click="OnManualPairClick" Width="80"/>
    </StackPanel>

    <!-- Error message -->
    <TextBlock x:Name="ErrorLabel" Foreground="#f87171" FontSize="12"
               HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
  </StackPanel>
</Window>
