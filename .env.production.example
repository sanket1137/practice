# ===========================================
# CCMS Production Environment Variables
# ===========================================
# Reference/template only. The GitHub Actions deploy workflow
# (.github/workflows/deploy.yml) does NOT read this file — it sources every
# one of these values from GitHub Actions Secrets/Variables and writes the
# server's .env itself on each deploy. See README/PR notes for the exact
# list of Secrets vs Variables to configure at:
#   Settings -> Secrets and variables -> Actions
#
# This file is only needed if you deploy manually via deploy-production.sh
# (copy it to /opt/ccms/.env on the server and fill in real values).
# DO NOT commit a filled-in copy of this file to version control.
# ===========================================

# ===========================================
# DATABASE (Neon PostgreSQL) — required
# ===========================================
POSTGRES_CONNECTION_STRING=Host=YOUR_NEON_HOST.neon.tech;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_NEON_PASSWORD;SSL Mode=Require

# ===========================================
# CLOUDFLARE R2 STORAGE — required
# ===========================================
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_URL_BASE=https://YOUR_R2_PUBLIC_DOMAIN.r2.dev
# Optional — only needed for automatic bucket CORS configuration on startup.
# Scope this key to bucket-admin permissions only, never account-wide.
R2_ADMIN_ACCESS_KEY_ID=
R2_ADMIN_SECRET_ACCESS_KEY=

# ===========================================
# JWT AUTHENTICATION — required
# ===========================================
# Generate a secure key: openssl rand -base64 64
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS

# ===========================================
# PAYMENTS (Razorpay) — required
# ===========================================
# The app refuses to process payments without KeyId/KeySecret configured.
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ===========================================
# APPLICATION URLS / DOMAIN — required
# ===========================================
FRONTEND_URL=https://ccms.yourdomain.com
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# ===========================================
# ERROR TRACKING (Sentry) — optional
# ===========================================
SENTRY_DSN=
VITE_SENTRY_DSN=

# ===========================================
# GOOGLE PLACES (screen auto-tagging) — optional
# ===========================================
GOOGLE_PLACES_API_KEY=

# ===========================================
# GOOGLE MAPS (frontend address autocomplete) — optional
# ===========================================
VITE_GOOGLE_MAPS_API_KEY=

# ===========================================
# WEBRTC TURN SERVER (live streaming NAT traversal) — optional but
# recommended; without it, streaming falls back to a public demo TURN relay
# ===========================================
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=
TURN_PASSWORD=

# ===========================================
# EMAIL SERVICE (AWS SES) — optional
# ===========================================
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# EMAIL SERVICE (SMTP) — optional alternative to AWS SES
# ===========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_ENABLE_SSL=true

# ===========================================
# SMS SERVICE (ComBirds) — optional
# ===========================================
COMBIRDS_API_KEY=
COMBIRDS_SENDER_ID=
COMBIRDS_TEMPLATE_ID=
COMBIRDS_USER_ID=
COMBIRDS_PASSWORD=

# ===========================================
# ADMIN CREDENTIALS (for initial setup) — not read by the app; documentation
# only, for whoever provisions the first admin account manually
# ===========================================
# Generate a strong random password — never reuse this example value.
# e.g. openssl rand -base64 24
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# ===========================================
# DEPLOY MECHANICS — only used by deploy-production.sh/.ps1, not by containers
# ===========================================
REMOTE_HOST=YOUR_SERVER_IP
REMOTE_USER=YOUR_DEPLOY_USER
