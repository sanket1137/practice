# ===========================================
# CCMS Production Environment Variables
# ===========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control!
# ===========================================

# ===========================================
# DATABASE (Neon PostgreSQL)
# ===========================================
POSTGRES_CONNECTION_STRING=Host=YOUR_NEON_HOST.neon.tech;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_NEON_PASSWORD;SSL Mode=Require

# ===========================================
# CLOUDFLARE R2 STORAGE
# ===========================================
R2_ACCOUNT_ID=YOUR_R2_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=YOUR_R2_BUCKET_NAME
R2_PUBLIC_URL=https://YOUR_R2_PUBLIC_DOMAIN.r2.dev

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a secure key: openssl rand -base64 64
JWT_SECRET_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS

# ===========================================
# APPLICATION URLS
# ===========================================
FRONTEND_URL=https://ccms.yourdomain.com
BACKEND_URL=https://api.ccms.yourdomain.com

# ===========================================
# DOMAIN CONFIGURATION
# ===========================================
DOMAIN=yourdomain.com
SSL_EMAIL=admin@yourdomain.com

# ===========================================
# EMAIL SERVICE (AWS SES) - Optional
# ===========================================
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@yourdomain.com

# ===========================================
# SMS SERVICE (ComBirds) - Optional
# ===========================================
COMBIRDS_API_KEY=
COMBIRDS_SENDER_ID=
COMBIRDS_TEMPLATE_ID=

# ===========================================
# ADMIN CREDENTIALS (for initial setup)
# ===========================================
# Generate a strong random password — never reuse this example value.
# e.g. openssl rand -base64 24
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
